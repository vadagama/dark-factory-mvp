{
  "name": "dark-factory-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Operator console of the Software Dark Factory (T036, ADR-021): React + Vite + TypeScript, served by nginx in the chart.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
