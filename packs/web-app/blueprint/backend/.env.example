# Copy to .env for local development; never commit .env - secrets stay out of
# git (ADR-009/ADR-015). Every variable the app reads is listed here.

# Application name reported by GET /
APP_NAME=example-product

# Async SQLAlchemy DSN (psycopg driver). For the in-chart PostgreSQL the
# secret carries this URL; locally point it at your docker postgres.
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@localhost:5432/app
